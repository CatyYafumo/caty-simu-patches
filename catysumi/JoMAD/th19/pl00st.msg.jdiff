{
    "3": {
        "4_0": {
            "lines": [
                "Ahg, no puede ser.",
                "¡Todo yo! ¡Todo yo!"
            ]
        },
        "12_0": {
            "lines": [
                "Tenía que salirsele de las manos.",
                "¡Y tener que yo ir a barrer todo...!"
            ]
        },
        "20_0": {
            "lines": [
                "Está bien, no lograré nada así."
            ]
        },
        "28_0": {
            "lines": [
                "Comencemos..."
            ]
        },
        "160_0": {
            "lines": [
                "¡Ey Sumiyoshi!",
                "Hace tiempo que no te veía."
            ]
        },
        "168_0": {
            "lines": [
                "¿Qué sucede? Te noto molesto."
            ]
        },
        "176_0": {
            "lines": [
                "Feny. ¡Mimé ha causado un desastre dimensional",
                "y tengo que arreglarlo yo mísmo ahora!"
            ]
        },
        "184_0": {
            "lines": [
                "Ella ya no puede hacerlo por sí mísma..."
            ]
        },
        "192_0": {
            "lines": [
                "Ah. Así que estás enojado por eso.~"
            ]
        },
        "200_0": {
            "lines": [
                "Bueno, eso explica por qué estamos",
                "en este bonito y extraño lugar."
            ]
        },
        "208_0": {
            "lines": [
                "Pero si te sirve... ¿Qué te parece",
                "una pequeña pelea?"
            ]
        },
        "216_0": {
            "lines": [
                "¡Justo estaba buscando algo de diversión!"
            ]
        },
        "224_0": {
            "lines": [
                "..."
            ]
        },
    },
    "4": {
        "34_0": {
            "lines": [
                "Bueno, eso estuvo genial... Heh..."
            ]
        },
        "42_0": {
            "lines": [
