    "0": {
        "94_0": {
            "lines": [
                "You are finally here."
            ]
        },
        "102_0": {
            "lines": [
                "You're finally here to join us."
            ]
        },
        "110_0": {
            "lines": [
                "Join?"
            ]
        },
        "118_0": {
            "lines": [
                "First I want to know all about this drama."
            ]
        },
        "126_0": {
            "lines": [
                "No, what am I saying..."
            ]
        },
        "134_0": {
            "lines": [
                "I will never join to you!"
            ]
        },
        "142_0": {
            "lines": [
                "And what is the sense of this?"
            ]
        },
        "150_0": {
            "lines": [
                "How did you teamed up with the Myouren Temple?"
            ]
        },
        "158_0": {
            "lines": [
                "Oh, it makes perfect sense~."
            ]
        },
        "166_0": {
            "lines": [
                "Oh no..."
            ]
        },
        "238_0": {
            "lines": [
                "I came too late!"
            ]
        },
        "246_0": {
            "lines": [
                "We got a problem. Seija..."
            ]
        },
        "254_0": {
            "lines": [
                "Uh? What is that?"
            ]
        },
        "262_0": {
            "lines": [
                "The main plan is ruined."
            ]
        },
        "270_0": {
            "lines": [
                "She don't came to join us."
            ]
        },
        "278_0": {
            "lines": [
                "She came to stop us, no matter why!"
            ]
        },
        "286_0": {
            "lines": [
                "Plan?! What plan you had on mind?"
            ]
        },
        "294_0": {
            "lines": [
                "It doesn't matter, fortunately I broke your prime strategy."
            ]
        },
        "302_0": {
            "lines": [
                "I see."
            ]
        },
        "310_0": {
            "lines": [
                "Don't worry. I know what to do."
            ]
        },
        "318_0": {
            "lines": [
                "...What are you going to do?"
            ]
        },
        "326_0": {
            "lines": [
                "Whatever..."
            ]
        },
        "334_0": {
            "lines": [
                "I must hurry to warn Byakuren on time."
            ]
        },
        "342_0": {
            "lines": [
                "Just cover me."
            ]
        },
        "418_0": {
            "lines": [
                "Answer me this:"
            ]
        },
        "426_0": {
            "lines": [
                "Why are you on the side of the Myouren Temple?"
            ]
        },
        "434_0": {
            "lines": [
                "I can't really believe this..."
            ]
        },
        "442_0": {
            "lines": [
                "You see."
            ]
        },
        "450_0": {
            "lines": [
                "It's so logical."
            ]
        },
        "458_0": {
            "lines": [
                "We both share something:"
            ]
        },
        "466_0": {
            "lines": [
                "The desire of changing society, failed to concrete."
            ]
        },
        "474_0": {
            "lines": [
                "This new reform will benefit even the weak."
            ]
        },
        "482_0": {
            "lines": [
                "Even to you. But it seems you don't want it."
            ]
        },
        "490_0": {
            "lines": [
                "So, you are not going to see the master",
                "before confronting me."
            ]
        },
        "498_0": {
            "lines": [
                "This time..."
            ]
        },
        "506_0": {
            "lines": [
                "You won't stop the rise of the weak!"
            ]
        },
        "514_0": {
            "lines": [
                "Witness...",
                "The Awakening of the New Order for Gensokyo!"
            ]
        }
